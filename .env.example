# Web app (Vite). Copy to .env.local.
VITE_API_URL=http://localhost:8787
VITE_CHAIN_ID=97
VITE_BSC_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
VITE_WC_PROJECT_ID=
VITE_DEFAULT_MODE=live
